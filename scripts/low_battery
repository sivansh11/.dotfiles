#!/bin/bash

while true; do
  # Get battery percentage (e.g., "75%") and remove the '%'
  battery_percentage=$(upower -i "$(upower -e | grep BAT)" | grep -E "percentage" | awk '{print $2}' | tr -d '%')

  # Check the battery state (e.g., "charging", "discharging", "fully-charged")
  battery_state=$(upower -i "$(upower -e | grep BAT)" | grep -E "state" | awk '{print $2}')

  # Check if battery is low (<= 20%) AND NOT charging (state is 'discharging')
  if [ "$battery_percentage" -le "20" ] && [ "$battery_state" = "discharging" ]; then
    # Send notification for low battery
    hyprctl notify 0 5000 0 " ⚠️ Low battery: ${battery_percentage}%"
    
    # Wait for a shorter time (e.g., 10 seconds) before re-checking
    sleep 10
  else
    # Battery is high OR charging, so sleep for a longer period (e.g., 5 minutes)
    sleep 300
  fi
done
