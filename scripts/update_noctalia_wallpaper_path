#!/bin/bash

CONFIG_FILE="$HOME/.config/noctalia/settings.json"
NEW_DIR=$1
if [ -z "$NEW_DIR" ]; then
    echo "Usage: $0 /path/to/wallpaper/directory"
    exit 1
fi

ABS_DIR=$(realpath -m "$NEW_DIR")
if [ ! -d "$ABS_DIR" ]; then
    echo "Error: Directory '$ABS_DIR' does not exist."
    exit 1
fi

if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: Noctalia config not found at $CONFIG_FILE"
    exit 1
fi

jq --arg dir "$ABS_DIR" '.wallpaper.directory = $dir' "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"

if [ $? -eq 0 ]; then
    echo "Successfully updated directory to: $ABS_DIR"
    echo "Refreshing Noctalia Shell..."
    qs -c noctalia-shell ipc call wallpaper refresh
else
    echo "Failed to update config file."
    exit 1
fi
