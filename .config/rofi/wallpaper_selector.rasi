/**
 * Rofi Wallpaper Selector Theme
 * A modern, image-focused theme for selecting wallpapers.
 */

@import "~/.cache/wal/colors-rofi-dark.rasi"

* {
    background-color: transparent;
    text-color:       @foreground;
}

window {
    transparency:     "real";
    background-color: @background;
    width:            85%;
    height:           85%;
    padding:          2em;
    border-radius:    24px;
    border:           2px;
    border-color:     @foreground;
}

mainbox {
    children:         [ listview ];
    background-color: transparent;
}

listview {
    columns:          5;
    lines:            3;
    spacing:          1em;
    cycle:            true;
    dynamic:          true;
    layout:           vertical;
    fixed-height:     false;
    fixed-columns:    true;
    background-color: transparent;
}

element {
    orientation:      vertical;
    spacing:          1em;
    padding:          1em;
    border-radius:    16px;
    cursor:           pointer;
    background-color: @background-alt;
}

element-icon {
    size:             150px;
    border-radius:    12px;
    cursor:           inherit;
}

element-text {
    enabled:          false; /* Set to 'true' to show filenames */
    horizontal-align: 0.5;
    cursor:           inherit;
}

element normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}

element selected.normal {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
    border:           2px;
    border-color:     @urgent-background;
}

inputbar {
    enabled:          false;
}

configuration {
  show-icons: true;
}
