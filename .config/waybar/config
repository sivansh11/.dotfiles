[
	{
		// "height": 35,
		// "width": 1536,
		"spacing": 0,
		"margin-top": 0,
		"margin-bottom": 0,
		"modules-left": [
			"pulseaudio",
			"custom/media"
		],
		"modules-center": [
			"hyprland/workspaces"
		],
		"modules-right": [
			"power-profiles-daemon",
			"network",
			"memory",
			"cpu",
			"temperature",
			"clock",
			"battery"
		],
		"pulseaudio": {
			"format": "{volume}% {icon}",
			"format-muted": "",
      "format-icons": {
        "headphone": "󰋋",
        "hands-free": "󰋎",
        "headset": "󰋎",
        "phone": "󰂑",
        "portable": "󰂑",
        "car": "󰚩",
        "default": ["󰕿", "󰖀", "󰕾"]
      }
		},
		"custom/media": {
			"format": "🎜 {text}",
			"return-type": "json",
			"exec": "$HOME/scripts/mediaplayer.py 2> /dev/null",
			"max-length": 35,
			"on-click": "playerctl play-pause"
		},
    "network": {
    	"format-wifi": "{essid} ({signalStrength}%) 󰤨",
      "format-ethernet": "{ipaddr}/{cidr} 󰈘",
      "tooltip-format": "{ifname} via {gwaddr} 󰈘",
      "format-linked": "{ifname} (No IP) 󰈘",
      "format-disconnected": "Disconnected ⚠"
    },
		"memory": {
			"format": "{}% ",
			"interval": 1
		},
    "cpu": {
      "format": "{usage}% ",
      "interval": 1
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "battery": {
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "{capacity}% {icon}",
      "format-charging": "{capacity}% 󰂄",
      "format-plugged": "{capacity}% ",
      "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    }
	}
]
